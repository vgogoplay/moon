{
  "rules": {
    ".read": "auth != null",

    "yuelao_admin_uids": {
      ".read": "auth != null"
    },

    "yuelao_users":                 { ".write": "auth != null" },
    "yuelao_user_index":            { ".write": "auth != null" },
    "yuelao_pair_profiles":         { ".write": "auth != null" },
    "yuelao_pair_ig":               { ".write": "auth != null" },
    "yuelao_wish_wall":             { ".write": "auth != null" },
    "yuelao_fate_wall":             { ".write": "auth != null" },
    "yuelao_forum_index":           { ".write": "auth != null" },
    "yuelao_forum_posts":           { ".write": "auth != null" },
    "yuelao_mailbox":               { ".write": "auth != null" },
    "yuelao_reports":               { ".write": "auth != null" },
    "yuelao_chats":                 { ".write": "auth != null" },
    "yuelao_unmatched_pairs":       { ".write": "auth != null" },
    "yuelao_activity_reg_history":  { ".write": "auth != null" },
    "yuelao_player_op_logs":        { ".write": "auth != null" },
    "yuelao_id_counters":           { ".write": "auth != null" },
    "yuelao_match_logs":            { ".write": "auth != null" },
    "yuelao_custom_act_locks":      { ".write": "auth != null" },
    "yuelao_inactive_chat_purge_logs": { ".write": "auth != null" },

    "yuelao_system_batch":          { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_custom_activities":     { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_test_event":            { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_session_match_results": { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_force_matches":         { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_auto_matched_sessions": { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_admin_login_logs":      { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" },
    "yuelao_banned_rules":          { ".write": "root.child('yuelao_admin_uids/' + auth.uid).val() === true" }
  }
